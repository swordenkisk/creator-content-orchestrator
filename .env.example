APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_PATH=creatorflow.db

COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_PATH=workflows/workflow_api.json
COMFYUI_POLL_SECONDS=2
COMFYUI_TIMEOUT_SECONDS=300

# Generate a long random value before deployment.
REVIEW_TOKEN=replace-with-a-long-random-secret

# Optional: Discord bot and review channel.
DISCORD_BOT_TOKEN=
DISCORD_REVIEW_CHANNEL_ID=

# Optional: comma-separated content categories.
CONTENT_CATEGORIES=behind-the-scenes,tutorial,product-showcase,story
